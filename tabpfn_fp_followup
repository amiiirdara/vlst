   "source": [
    "if not os.path.isfile(FULL_DATA_PATH):\n",
    "    raise FileNotFoundError(\n",
    "        f\"Missing full dataset at {FULL_DATA_PATH}. Set VLST_FULL_DATA_PATH before running.\"\n",
    "    )\n",
    "if not os.path.isfile(UNION_CSV):\n",
    "    raise FileNotFoundError(\n",
    "        f\"Missing {UNION_CSV}. Run fp_precision_mining.ipynb first or set VLST_FP_OUTPUT_DIR / VLST_FP_RUN_TAG.\"\n",
    "    )\n",
    "\n",
    "df_full = pd.read_csv(FULL_DATA_PATH)\n",
    "df_union = pd.read_csv(UNION_CSV)\n",
    "if \"test_row_id\" not in df_union.columns:\n",
    "    raise ValueError(\"Union CSV must contain test_row_id.\")\n",
    "\n",
    "# --- Target column detection on full dataset ---\n",
    "forced_target = os.environ.get(\"VLST_FULLDATA_TARGET_COL\", \"\").strip()\n",
    "if forced_target:\n",
    "    if forced_target not in df_full.columns:\n",
    "        raise ValueError(f\"VLST_FULLDATA_TARGET_COL={forced_target!r} not found in full dataset columns.\")\n",
    "    target_col = forced_target\n",
    "else:\n",
    "    preferred = [\n",
    "        \"target\", \"label\", \"y\", \"class\", \"Class\", \"Outcome\", \"outcome\",\n",
    "        \"VLST\", \"vlst\", \"StentThrombosis\", \"stent_thrombosis\",\n",
    "    ]\n",
    "    target_col = None\n",
    "    for c in preferred:\n",
    "        if c in df_full.columns:\n",
    "            vals = set(pd.Series(df_full[c]).dropna().astype(int).unique().tolist())\n",
    "            if vals.issubset({0, 1}) and len(vals) >= 1:\n",
    "                target_col = c\n",
    "                break\n",
    "    if target_col is None:\n",
    "        bin_cols = []\n",
    "        for c in df_full.columns:\n",
    "            s = pd.to_numeric(df_full[c], errors=\"coerce\").dropna()\n",
    "            vals = set(s.unique().tolist())\n",
    "            if len(vals) > 0 and vals.issubset({0, 1}):\n",
    "                bin_cols.append(c)\n",
    "        if not bin_cols:\n",
    "            raise ValueError(\n",
    "                \"Could not infer binary target column in full dataset. Set VLST_FULLDATA_TARGET_COL explicitly.\"\n",
    "            )\n",
    "        target_col = bin_cols[-1]\n",
    "\n",
    "print(\"Using target column from full data:\", target_col)\n",
    "\n",
    "y_full = pd.to_numeric(df_full[target_col], errors=\"coerce\").fillna(0).astype(int).to_numpy()\n",
    "if not set(np.unique(y_full)).issubset({0, 1}):\n",
    "    raise ValueError(\"Target column must be binary (0/1).\")\n",
    "\n",
    "# Use numeric feature columns (excluding target). Keep columns shared with union output.\n",
    "X_full_df = df_full.drop(columns=[target_col]).copy()\n",
    "for c in X_full_df.columns:\n",
    "    X_full_df[c] = pd.to_numeric(X_full_df[c], errors=\"coerce\")\n",
    "\n",
    "# Union contains feature columns + metadata columns; shared numeric feature names are safest alignment.\n",
    "meta_cols = {\n",
    "    \"test_row_id\", \"y_true\", \"p_winner\", \"p_tabpfn\", \"fp_winner\",\n",
    "    \"fp_tabpfn_legacy_t\", \"fp_tabpfn_any_grid_t\", \"source\", \"threshold\"\n",
    "}\n",
    "union_feature_candidates = [c for c in df_union.columns if c not in meta_cols]\n",
    "shared_features = [c for c in union_feature_candidates if c in X_full_df.columns]\n",
    "if not shared_features:\n",
    "    raise ValueError(\n",
    "        \"No shared feature columns between full dataset and union CSV. \"\n",
    "        \"Check preprocessing consistency or supply mapped features.\"\n",
    "    )\n",
    "\n",
    "X_full_use = X_full_df[shared_features].copy()\n",
    "X_union_use = df_union[shared_features].copy()\n",
    "for c in shared_features:\n",
    "    X_union_use[c] = pd.to_numeric(X_union_use[c], errors=\"coerce\")\n",
    "\n",
    "# Median-impute numeric NaNs so TabPFN can train.\n",
    "med = X_full_use.median(numeric_only=True)\n",
    "X_full_use = X_full_use.fillna(med)\n",
    "X_union_use = X_union_use.fillna(med)\n",
    "\n",
    "pos_idx = np.flatnonzero(y_full == 1)\n",
    "tn_pool_idx = np.flatnonzero(y_full == 0)\n",
    "n_pos = int(pos_idx.size)\n",
    "if n_pos == 0:\n",
    "    raise ValueError(\"No positives in full dataset target column.\")\n",
    "if tn_pool_idx.size < n_pos:\n",
    "    raise ValueError(f\"Need {n_pos} true negatives but only {tn_pool_idx.size} available in full dataset.\")\n",
    "\n",
    "rng = np.random.RandomState(RANDOM_STATE)\n",
    "tn_sample_idx = rng.choice(tn_pool_idx, size=n_pos, replace=False)\n",
    "\n",
    "X_pos = X_full_use.iloc[pos_idx].to_numpy(dtype=np.float32)\n",
    "X_tn = X_full_use.iloc[tn_sample_idx].to_numpy(dtype=np.float32)\n",
    "X_fp = X_union_use.to_numpy(dtype=np.float32)\n",
    "\n",
    "y_pos = np.ones(X_pos.shape[0], dtype=int)\n",
    "y_tn = np.zeros(X_tn.shape[0], dtype=int)\n",
    "y_fp = np.zeros(X_fp.shape[0], dtype=int)\n",
    "\n",
    "X_cohort = np.vstack([X_pos, X_tn, X_fp])\n",
    "y_cohort = np.concatenate([y_pos, y_tn, y_fp])\n",
    "\n",
    "# Shuffle once before train/val/test split.\n",
    "perm = rng.permutation(X_cohort.shape[0])\n",
    "X_cohort = X_cohort[perm]\n",
    "y_cohort = y_cohort[perm]\n",
    "\n",
    "print(\n",
    "    \"Cohort | full-data positives:\", X_pos.shape[0],\n",
    "    \"| full-data true negatives sampled:\", X_tn.shape[0],\n",
    "    \"| mined union FPs added:\", X_fp.shape[0],\n",
    "    \"| total rows:\", X_cohort.shape[0],\n",
    ")\n",
    "print(\"Features used:\", len(shared_features))\n"
   ]
